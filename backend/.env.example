# ──────────────────────────────────────────────────────────────────────────────
# AI Interview Agent — Environment Variables
# Copy this file to `.env` in the `backend` directory and add your Groq API Key.
# ──────────────────────────────────────────────────────────────────────────────

# Groq API Key (get yours at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Mode selection: Set to `false` (or leave empty) to use live Groq LLM.
# Set to `true` to force offline mock mode for testing without an API key.
MOCK_MODE=false

# Server settings
HOST=0.0.0.0
PORT=8000
